docker.enabled = true

params {
    sample_id      = 'NA12878'
    reads_r1       = 'data/coverage_0.65x/NA12878_R1.fastq.gz'
    reads_r2       = 'data/coverage_0.65x/NA12878_R2.fastq.gz'
    reference      = '../shared-reference/GRCh38/Homo_sapiens.GRCh38.dna.primary_assembly.fa'
    reference_dict = '../shared-reference/GRCh38/Homo_sapiens.GRCh38.dna.primary_assembly.dict'    
    interval       = '21'
    outdir         = 'results'
}
